[{"concept":"bjt_basics","description":"全程答对、无提示 → 必须判 mastered（掌握只认独立测验全对 + 不靠提示）","expect":{"mastery":"mastered"},"id":"tc01_perfect_student","style":"all_correct"},{"concept":"bjt_basics","description":"全程答错 → 必须判 needs_review，且不得假装掌握","expect":{"mastery":"needs_review"},"id":"tc02_all_wrong","style":"all_wrong"},{"concept":"bjt_basics","description":"每题先要 2 次提示再答对、测验全对 → 只能判 passed_with_help（提示上限为 1）","expect":{"mastery":"passed_with_help"},"hints_before_each_answer":2,"id":"tc03_hint_dependent","style":"correct_with_hints"},{"concept":"bjt_basics","description":"引导阶段第一题连错两次（触发薄弱标记）、其余全对、测验全对 → passed_with_help","expect":{"mastery":"passed_with_help"},"id":"tc04_guided_struggle","style":"guided_struggle"},{"concept":"bjt_basics","description":"诊断题故意选带误区码的错误选项 → 学习者画像必须记下该误区","expect":{"profile_contains_misconception":true},"id":"tc05_misconception_attribution","style":"first_wrong_misconception"},{"concept":"bjt_basics","description":"信心填 5 却答错 → 结果必须带 calibration 提醒（抓“自以为会”）","expect":{"calibration_flag":true},"id":"tc06_overconfident_flag","style":"first_confident_wrong"},{"concept":"bjt_basics","description":"独立测验阶段请求提示 → 必须被拒绝（抛错），这是掌握证据的底线","expect":{"hint_error":true},"id":"tc07_hint_blocked_in_test","style":"hint_in_test"}]